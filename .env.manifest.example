# Copy this file to .env.manifest and fill in local secrets/configuration.
# Do not commit .env.manifest.

# LLM provider API keys referenced by manifest module config.api_key_env.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
LOCAL_LLM_API_KEY=

# Orchid UI follow-up/user-input endpoint used by RobotSession.
ORCHID_UI_URL=http://localhost:8000
ORCHID_UI_FOLLOWUP_URL=http://localhost:8000/api/followup
ORCHID_UI_FOLLOWUP_TIMEOUT=300

# Dispatch manifest loading.
CONFIG_DISPATCH_MANIFEST_TYPE=file
CONFIG_DISPATCH_MANIFEST_FILES=/home/orchid/orchid_server/manifests/example_manifest_hsrb.json
ORCHID_SCENE_GRAPH_PATH=/home/orchid/orchid_server/config/scene/scene_graph.json

# Speech output: current (browser), off, or tmc (/talk_request).
ORCHID_SPEECH_MODE=current